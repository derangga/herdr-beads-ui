{
  "// why": "Paddock's mods are clones of herdr-app's own, typed the way herdr-app's jsconfig types a mod: strictNullChecks off, because a View sets its state in init, which TypeScript cannot see.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "strictNullChecks": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "paths": { "herdr": ["../../herdr.d.ts"] }
  },
  "files": ["../../gpui-kit.d.ts"],
  "include": ["*.ts", "*/main.ts"]
}
